# Copy to .env. Never commit real credentials.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional: change LLM_PROVIDER above to openai for an OpenAI-compatible API.
# Groq offers a rate-limited Free Plan; no paid service is required.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# Existing GENERATION_PROVIDER and MODEL_NAME settings remain supported aliases.
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_MAX_RETRIES=2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RUNTIME_DIR=runtime
RETRIEVAL_MODE=hybrid

# Tracing is opt-in. Use only synthetic user data in shared traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asterline-research-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
