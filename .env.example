# Copy to .env. Never commit real credentials.
GENERATION_PROVIDER=openai
# Free-tier Groq through the OpenAI-compatible adapter. Stay on Groq's Free Plan.
MODEL_NAME=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Put your Groq key in this adapter's OPENAI_API_KEY variable.
OPENAI_API_KEY=
# For Ollama: GENERATION_PROVIDER=ollama; MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_MAX_RETRIES=2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RUNTIME_DIR=runtime
RETRIEVAL_MODE=hybrid

# Tracing is opt-in. Use only synthetic user data in shared traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asterline-research-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
